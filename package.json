{
  "name": "nkommo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Nkommo \u2014 a private, offline-first AI journal and mood tracker built for Ghana.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "typecheck": "tsc -b --pretty",
    "eval": "tsx src/engine/eval/run.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "jsdom": "^31.0.0",
    "tailwindcss": "4.3.4",
    "tsx": "^4.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "vitest": "^5.1.0"
  }
}
