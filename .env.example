# Cloud backup (optional). Copy to .env.local and fill from the Firebase console.
# Without these the app stays fully local and Settings says cloud is not configured.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Point the client at local emulators (auth :9099, firestore :8080) instead of a project.
VITE_FIREBASE_EMULATOR=0

# Optional HTTPS endpoint that accepts a raw audio body and returns { "text": "..." }.
# The reference implementation is functions/transcribe. Used only when the browser has
# no SpeechRecognition but does have a microphone.
VITE_TRANSCRIBE_URL=
