# Optional server proxy for Hugging Face reflections (e.g. Firebase Cloud Function `chat`).
# When set, the mobile app calls this URL without needing a user token on the phone.
EXPO_PUBLIC_HF_ENDPOINT=

# Optional HTTPS endpoint accepting raw audio POST and returning { "text": "..." }
# for server-assisted transcription of recorded voice notes on Android/iOS.
EXPO_PUBLIC_TRANSCRIBE_URL=
